/* ══════════════════════════════════════════════════════════════════════════════════════════════
   VỎ TRANG BÀI TẬP — §41.7 (trang web TỰ DO, không theo TB1/TB2/TB3 của app)
   ──────────────────────────────────────────────────────────────────────────────────────────────
   ⚠ BÀI HỌC §32.24 (đã sai 3 lần với riêng layout ô chữ): slide app là khung CỨNG 960×540 +
     transform:scale. Trên điện thoại dọc, thu cho vừa bề ngang thì chữ nhỏ không đọc nổi, và mọi
     mẹo chia lại lưới đều hỏng vì chiều cao đã được tính sẵn cho màn hình lớn.
     CÁCH ĐÚNG DUY NHẤT: ở màn hẹp thì BỎ HẲN khung cố định + BỎ transform, trả .sl về
     height:auto/width:100%, cho cả trang cuộn dọc như trang web bình thường.
   ⚠ baigiang.css (chép từ app) định nghĩa .sl và mọi layout — file này chỉ bọc NGOÀI và ghi đè
     phần khung. KHÔNG sửa baigiang.css bằng tay: nó là bản chép từ app.
   ══════════════════════════════════════════════════════════════════════════════════════════════ */

:root {
  --xanh: #1976D2;
  --xanh-dam: #0D47A1;
  --xam: #f4f6f8;
  --vien: #d8dde3;
  --do: #d32f2f;
  --luc: #2e7d32;
  --cam: #ef6c00;
}

* { box-sizing: border-box; }
/* ⚠⚠ PHẢI GHI ĐÈ `html,body` CỦA baigiang.css — NGUYÊN NHÂN LỖI KHÔNG CUỘN ĐƯỢC (2026-09-01).
   baigiang.css dòng 19 khai `html,body{height:100vh;overflow:hidden}` vì đó là CSS của app
   ELECTRON — app chạy toàn màn hình trong cửa sổ cố định nên cố tình khoá cuộn trang. Ta chép
   nguyên file đó sang web (để slide hiển thị y hệt trong app) nên thừa hưởng luôn cái khoá:
   nội dung cao 2125px bị nhốt trong khung 502px, không cuộn được, KHÔNG có dấu hiệu gì.
   Trên máy tính màn rộng thì nội dung vừa màn hình nên không lộ ra — chỉ điện thoại mới thấy.
   ⚠ trang.css PHẢI nạp SAU baigiang.css trong <head> thì rule này mới thắng. */
html, body {
  margin: 0; padding: 0;
  font-family: 'Segoe UI', Roboto, Arial, sans-serif;
  background: var(--xam); color: #1a1a1a;
  height: auto;        /* ghi đè height:100vh */
  min-height: 100%;
  overflow: visible;   /* ghi đè overflow:hidden — để trang cuộn tự nhiên */
}
/* Chặn tràn ngang bằng `clip` (KHÔNG tạo vùng cuộn riêng như `hidden`, nên không khoá cuộn dọc) */
body { overflow-x: clip; }
.an { display: none !important; }

/* ── Màn hình dạng hộp giữa (vào bài / đã nộp) ────────────────────────────────────────────── */
.man { min-height: 100dvh; display: flex; align-items: center; justify-content: center; padding: 10px; }
.hop {
  background: #fff; border: 1px solid var(--vien); border-radius: 10px;
  padding: 10px; width: 100%; max-width: 380px; text-align: center;
}
.hop h1 { font-size: 20px; margin: 6px 0; color: var(--xanh-dam); }
.phu { font-size: 13px; color: #5b6570; margin: 4px 0 10px; }
.nhan { display: block; text-align: left; font-size: 13px; font-weight: 600; margin: 8px 0 4px; }
.goiy { font-weight: 400; color: #8a939c; }
.o {
  width: 100%; height: 40px; padding: 0 10px; font-size: 15px;
  border: 1px solid var(--vien); border-radius: 6px; outline: none; background: #fff;
}
.o:focus { border-color: var(--xanh); }
.o-ma { font-size: 24px; text-align: center; letter-spacing: 6px; font-weight: 700; height: 50px; }
.loi { color: var(--do); font-size: 13px; min-height: 18px; margin-top: 6px; }

.bt {
  height: 36px; padding: 0 14px; font-size: 14px; font-weight: 600;
  border: 1px solid var(--vien); border-radius: 6px; background: #fff; color: #222;
  cursor: pointer; transition: .15s;
}
.bt:hover:not(:disabled) { background: #f0f4f8; }
.bt:disabled { opacity: .45; cursor: not-allowed; }
.bt-chinh { width: 100%; margin-top: 10px; height: 42px; background: var(--xanh); color: #fff; border-color: var(--xanh); }
.bt-chinh:hover:not(:disabled) { background: var(--xanh-dam); }
.bt-nop { background: var(--luc); color: #fff; border-color: var(--luc); }
.bt-phu { min-width: 44px; }

/* ── Màn làm bài ──────────────────────────────────────────────────────────────────────────── */
#manBai { flex-direction: column; align-items: stretch; padding: 0; }
.dau, .chan {
  flex: 0 0 44px; display: flex; align-items: center; gap: 8px;
  padding: 0 10px; background: #fff; border-bottom: 1px solid var(--vien);
}
.chan { border-bottom: none; border-top: 1px solid var(--vien); justify-content: center; }
.dau { justify-content: space-between; }
#dauCau { font-size: 13px; font-weight: 600; color: #5b6570; }
.gio { font-size: 15px; font-weight: 700; color: var(--xanh-dam); font-variant-numeric: tabular-nums; }
.gio.gap { color: var(--do); }

.san { flex: 1 1 auto; display: flex; align-items: center; justify-content: center; overflow: auto; padding: 10px; }

/* Đèn báo tiến độ */
.den { display: flex; gap: 5px; flex-wrap: wrap; justify-content: center; max-width: 60vw; }
.cham { width: 9px; height: 9px; border-radius: 50%; background: #cfd6dd; display: block; }
.cham.xong { background: var(--xanh); }
.cham.nay { outline: 2px solid var(--cam); outline-offset: 1px; }

/* Kết quả */
.diem { font-size: 40px; font-weight: 700; color: var(--xanh-dam); margin: 6px 0; }
.qs { display: flex; gap: 3px; flex-wrap: wrap; justify-content: center; margin-bottom: 8px; }
.qs i { width: 14px; height: 14px; border-radius: 3px; display: block; }
.qs i.d { background: var(--luc); }
.qs i.s { background: var(--do); }

/* Băng thông báo — đè mép trên, đồng bộ mirror-host (§32.4) */
.banner {
  position: fixed; top: 0; left: 50%; transform: translateX(-50%);
  background: var(--xanh); color: #fff; font-weight: 500; font-size: 14px;
  padding: 10px 18px; border-radius: 0 0 8px 8px; z-index: 9900; max-width: 92vw; text-align: center;
}
.banner--nhac { background: var(--cam); }
.banner--ok { background: var(--luc); }

/* ══ MÁY TÍNH / TABLET NGANG: giữ khung 960×540 của app, thu cho vừa ══════════════════════ */
@media (min-width: 701px) {
  .san .sl {
    width: 960px; height: 540px; flex: 0 0 auto;
    transform: scale(var(--ty-le, 1)); transform-origin: center center;
  }
}

/* ══ ĐIỆN THOẠI DỌC: BỎ khung cứng, cho trang cuộn dọc (§41.7 — bài học §32.24) ═══════════ */
@media (max-width: 700px) {
  /* CẢ TRANG cuộn dọc như trang web thường; thanh trên/dưới DÍNH mép để nút Nộp bài luôn thấy.
     KHÔNG cuộn bên trong .san — cách đó làm vùng cuộn lồng nhau, rất khó dùng trên cảm ứng. */
  #manBai { display: block; min-height: 100dvh; }
  .dau { position: sticky; top: 0; z-index: 10; }
  .chan { position: sticky; bottom: 0; z-index: 10; }
  .san { display: block; overflow: visible; padding: 0; }

  .san .sl {
    width: 100% !important; height: auto !important; min-height: 0 !important;
    max-width: 100%; transform: none !important;   /* ⚠ BỎ scale — nếu không chữ nhỏ không đọc nổi */
    border-radius: 0; box-shadow: none; display: block;
  }

  /* ⚠⚠ MẤU CHỐT — PHẢI GỠ `flex:1`, KHÔNG CHỈ `height:auto`.
     baigiang.css khai `.sl .mcql{flex:1;min-height:0;overflow-y:auto}` = "chiếm phần DƯ của khung
     cao 540px". Bỏ chiều cao cố định đi thì phần dư thành 0 ⇒ vùng câu hỏi CO VỀ 0, các câu biến
     mất và không cuộn được (đã gặp trên điện thoại 2026-09-01). `height:auto` KHÔNG cứu được vì
     flex-basis:0 vẫn thắng. Phải đặt `flex:0 0 auto` để vùng cao đúng bằng nội dung. */
  .san .sl .mcql,
  .san .sl .questions-panel,
  .san .sl .passage-panel,
  .san .sl .qp-rs3,
  .san .sl .sl-body,
  .san .sl .sl-col {
    flex: 0 0 auto !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    overflow: visible !important;
    display: block !important;
  }

  /* Header slide khai `flex:0 0 15%; height:10%` — tính theo khung 540px, vô nghĩa khi cao tự do */
  .san .sl .sl-head { flex: 0 0 auto !important; height: auto !important; }

  /* 4 lựa chọn xếp 4 cột ngang (opts-c4) thì trên màn hẹp phải xuống thành 1 cột */
  .san .sl .options-container { display: block !important; }
  .san .sl .option-item { width: auto !important; margin-bottom: 6px; }

  /* Bảng / lưới rộng: nhốt cuộn ngang vào RIÊNG nó, không cho tràn cả trang.
     ⚠ min-width:0 là mấu chốt — thiếu nó flex item không co xuống dưới bề rộng nội dung. */
  .san .sl table, .san .sl .cw-left { display: block; min-width: 0; max-width: 100%; overflow-x: auto; }
  .dau, .chan { flex-basis: 48px; }
  .den { max-width: 55vw; }
}
